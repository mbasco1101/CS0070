section .text

    global _start
print_string:
    mov eax, 4              
    mov ebx, 1              
    int 0x80
    ret

print_border:
    mov ecx, 70             ; loop counter

.border_loop:
    push ecx                ; preserve counter

    mov eax, 4              ; sys_write
    mov ebx, 1              ; standard output
    mov ecx, star            ; character to print
    mov edx, 1              ; print one character
    int 0x80

    pop ecx                 ; restore counter
    loop .border_loop       ; repeat until ECX becomes zero

    mov ecx, newline
    mov edx, 1
    call print_string
    ret


_start:
